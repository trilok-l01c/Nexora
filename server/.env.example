MONGODB_URI=mongodb://127.0.0.1:27017/nexora
PORT=4292
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
ADMIN_EMAIL=admin@nexora.studio
ADMIN_PASSWORD=replace-with-a-long-password
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_EXPIRES_IN=2h
# Comma-separated explicit browser origins. Never use * with credentials.
# CORS_ORIGIN=https://app.example.com,https://branch--site.netlify.app

# Cookie defaults support app.example.com -> api.example.com (same-site).
# Set to none only for HTTPS cross-site previews such as *.netlify.app.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com

# Local development uses the filesystem. Production requires S3-compatible
# storage so uploads survive redeploys.
STORAGE_DRIVER=local
# S3_ENDPOINT=https://s3.example-provider.com
# S3_REGION=us-east-1
# S3_BUCKET=nexora-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.example.com
